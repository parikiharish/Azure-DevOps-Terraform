@'
# Terraform working directory
**/.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*

# Terraform plan files
*.tfplan
tfplan
plan.out

# Terraform crash logs
crash.log
crash.*.log

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Local environment and credentials
.env
.env.*
*.pem
*.key
*.pfx
*.credentials
.vscode/

# Temporary files
*.log
terraform-staged-changes.patch

'@ | Set-Content .gitignore